@model MovieCatalogue.ViewModels.UserDetailsViewModel

<h2>User Details</h2>

<div class="row">
    <div class="col-md-6">
        <table class="table">
            <tr>
                <th>Id</th>
                <td>@Model.Id</td>
            </tr>
            <tr>
                <th>First Name</th>
                <td>@Model.FirstName</td>
            </tr>
            <tr>
                <th>Last Name</th>
                <td>@Model.LastName</td>
            </tr>
        </table>
    </div>
</div>

<h3>Watched Movies (@Model.Reviews.Count)</h3>

@if (Model.Reviews.Any())

{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Movie</th>
                <th>Genre</th>
                <th>Your Rating</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var review in Model.Reviews)

            {
                <tr>
                    <td>
                        <a asp-controller="Movies"
                           asp-action="Details"
                           asp-route-id="@review.MovieId">
                            @review.Movie.Title
                        </a>
                    </td>
                    <td>@review.Movie.Genre</td>
                    <td>@review.Rating/10</td>
                    <td>
                        <a asp-controller="Reviews"
                           asp-action="Edit"
                           asp-route-userId="@review.UserId"
                           asp-route-movieId="@review.MovieId"
                           class="btn btn-primary btn-sm">
                            Edit
                        </a>

                        <a asp-controller="Reviews"
                           asp-action="Delete"
                           asp-route-userId="@review.UserId"
                           asp-route-movieId="@review.MovieId"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

else

{
    <p>You haven't reviewed any movies yet.</p>
}

<hr />

<h3>All Movies (@Model.AllMovies.Count)</h3>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Genre</th>
            <th>Release Year</th>
            <th>Catalogue Rating</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model.AllMovies)

        {

            var reviewed = Model.Reviews

            .Any(r => r.MovieId == movie.Id);

            <tr>
                <td>
                    <a asp-controller="Movies"
                       asp-action="Details"
                       asp-route-id="@movie.Id">
                        @movie.Title
                    </a>
                </td>
                <td>@movie.Genre</td>
                <td>@movie.ReleaseYear</td>
                <td>@movie.Rating/10</td>
                <td>
                    @if (reviewed)
                    {
                        <span class="badge bg-success">
                            Reviewed
                        </span>
                    }
                    else
                    {
                        <a asp-controller="Reviews"
                           asp-action="Create"
                           asp-route-userId="@Model.Id"
                           asp-route-movieId="@movie.Id"
                           class="btn btn-success btn-sm">
                            Write Review
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Back</a>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>