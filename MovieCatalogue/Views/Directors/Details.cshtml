@model MovieCatalogue.ViewModels.DirectorDetailsViewModel

<h2>Director Details</h2>

<div class="row">
    <div class="col-md-6">
        <table class="table">
            <tr>
                <th>Id</th>
                <td>@Model.Id</td>
            </tr>
            <tr>
                <th>First Name</th>
                <td>@Model.FirstName</td>
            </tr>
            <tr>
                <th>Last Name</th>
                <td>@Model.LastName</td>
            </tr>
            <tr>
                <th>Birth Date</th>
                <td>@Model.BirthDate.ToShortDateString()</td>
            </tr>
            <tr>
                <th>Nationality</th>
                <td>@Model.Nationality</td>
            </tr>
            <tr>
                <th>Biography</th>
                <td>@Model.Biography</td>
            </tr>
        </table>
    </div>
</div>

<h3>Movies (@Model.Movies.Count)</h3>
@if (Model.Movies.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Title</th>
                <th>Genre</th>
                <th>Release Year</th>
                <th>Duration</th>
                <th>Rating</th>
                <th>Language</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Model.Movies)
            {
                <tr>
                    <td>
                        <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id">@movie.Title</a>
                    </td>
                    <td>@movie.Genre</td>
                    <td>@movie.ReleaseYear</td>
                    <td>@movie.Duration min</td>
                    <td>@movie.Rating/10</td>
                    <td>@movie.Language</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No movies found for this director.</p>
}

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>